<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
  <j:set var="comp" value="${c != null ? c : it}"/>
  <j:set var="data" value="${from.data(comp)}"/>
  <td align="right" tooltip="${data.tooltip}">
    <j:choose>
      <j:when test="${data != null}">${data.shortName}</j:when>
      <j:otherwise><span class="jenkins-!-warning-color">N/A</span></j:otherwise>
    </j:choose>
  </td>
</j:jelly>
