<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!-- Evaluated first: it checks the permission before anything is rendered. -->
  <j:set var="volumes" value="${it.volumes}"/>
  <l:layout title="Storage">
    <st:include page="sidepanel.jelly" it="${it.computer}"/>
    <l:main-panel>
      <h1>Storage</h1>
      <p class="jenkins-description">
        The drives and volumes the node can use, such as local disks, network shares and mounted
        volumes. The <b>Drive</b> column shows SSD or HDD when the node can tell, which it often cannot for network
        shares, virtual disks and containers. The volume marked <b>Builds</b> holds the working directory
        of the node.
      </p>
      <j:choose>
        <j:when test="${volumes == null and it.computer.channel == null}">
          <p class="jenkins-description">The storage is only available while the node is connected to Jenkins.</p>
        </j:when>
        <j:when test="${volumes == null}">
          <p>The node did not report its storage in time. Reload the page to try again.</p>
        </j:when>
        <j:when test="${volumes.isEmpty()}">
          <p>No drives or volumes were found on the node.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table" style="width: auto; max-width: 100%;">
            <thead>
              <tr><th>Mount</th><th>Device</th><th>Type</th><th>Drive</th><th>Size</th><th>Free</th><th></th></tr>
            </thead>
            <tbody>
              <j:forEach var="v" items="${volumes}">
                <tr>
                  <td>${v.mount}</td>
                  <td>${v.name}</td>
                  <td>${v.type}</td>
                  <td>${v.driveType}</td>
                  <td>${v.totalDisplay}</td>
                  <td>${v.freeDisplay}</td>
                  <td>
                    <j:if test="${v.workspace}"><b>Builds</b></j:if>
                    <j:if test="${v.readOnly}"> read-only</j:if>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
