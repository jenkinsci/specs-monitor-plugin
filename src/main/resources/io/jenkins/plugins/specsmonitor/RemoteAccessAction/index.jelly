<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!-- Evaluated first: it checks the permission before anything is rendered. -->
  <j:set var="target" value="${it.target}"/>
  <l:layout title="Remote Access">
    <st:include page="sidepanel.jelly" it="${it.computer}"/>
    <l:main-panel>
      <h1>Remote Access</h1>
      <j:if test="${it.computer.offline and target != null and target.ip != null}">
        <p class="jenkins-description">
          The node is offline. The address is the one it last reported and may be out of date.
        </p>
      </j:if>
      <j:choose>
        <j:when test="${target == null or target.ip == null}">
          <p>
            <j:choose>
              <j:when test="${it.computer.offline}">The node is offline and its address was never collected. Enable the Connection monitor and bring the node online once.</j:when>
              <j:otherwise>The address of the node could not be determined.</j:otherwise>
            </j:choose>
          </p>
        </j:when>
        <j:when test="${target.windows}">
          <p>
            Opens a <b>Remote Desktop connection</b> for ${target.ip}.
          </p>
          <br />
          <br />
          <p><a class="jenkins-button jenkins-button--primary" href="rdp">Download .rdp file</a> <a class="jenkins-button" style="margin-left: 1rem;" href="${target.rdpUri}">Open rdp:// link</a></p>
          <p class="jenkins-description">
            The <code>rdp://</code> link only works if a client that handles it is installed, such as the
            Microsoft Remote Desktop or Windows App client. The built-in Windows client does not, so use the
            download there.
          </p>
        </j:when>
        <j:when test="${target.sshCapable}">
          <p>
            Opens the SSH client registered on your computer for ${target.ip}. If nothing happens, run
            this command in a terminal:
          </p>
          <p><code>${target.sshCommand}</code></p>
          <br />
          <br />
          <p><a class="jenkins-button jenkins-button--primary" href="${target.sshUri}">Connect with SSH</a></p>
        </j:when>
        <j:otherwise>
          <p>Remote Access is only offered for Windows, Linux and macOS nodes.</p>
        </j:otherwise>
      </j:choose>
      <j:set var="users" value="${it.connectedUsers}"/>
      <h2>Connected users</h2>
      <j:choose>
        <j:when test="${users == null}">
          <p class="jenkins-description">The connected users are only available while the node is connected to Jenkins.</p>
        </j:when>
        <j:when test="${users.isEmpty()}">
          <p>No users are connected to the node.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table" style="width: auto; min-width: 20rem; max-width: 100%;">
            <thead>
              <tr><th>User</th><th>Session</th></tr>
            </thead>
            <tbody>
              <j:forEach var="s" items="${users}">
                <tr><td>${s.user}</td><td>${s.detail}</td></tr>
              </j:forEach>
            </tbody>
          </table>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
